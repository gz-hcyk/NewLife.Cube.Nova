@model LoginViewModel
@using NewLife
@using System.Web
@using NewLife.Cube
@using NewLife.Cube.Areas.Admin.Models
@{
    // 第三方登录面板（Nova 观感）。站点级分部视图，供 Login.cshtml / MLogin.cshtml 渲染。
    //
    // 与框架内置版一致：仅在 OAuthItems 非空时输出，避免无第三方登录时留下空分隔线。
    // 未再使用 glyphicon / ace-icon（登录页已不加载 bootstrap.css 与 Cube.css），改用内联 SVG 与文字兜底。

    var set = Model;
    var items = set.OAuthItems;
}
@if (items != null && items.Count > 0)
{
    <div class="nv-login-oauth">
        <div class="nv-oauth-sep"><span>第三方登录</span></div>
        <div class="nv-oauth-list">
            @foreach (var mi in items)
            {
                var nickName = !mi.NickName.IsNullOrEmpty() ? mi.NickName : mi.Name;

                var url = "/Sso/Login?name=" + mi.Name;
                if (!set.ReturnUrl.IsNullOrEmpty())
                {
                    url += "&r=" + HttpUtility.UrlEncode(set.ReturnUrl);
                }

                var logo = !mi.Logo.IsNullOrEmpty() ? mi.Logo : ViewHelper.GetLogo(mi.Name);

                <a class="nv-oauth-item" href="@url" title="@nickName">
                    @if (!logo.IsNullOrEmpty())
                    {
                        <img src="@logo" alt="@nickName" />
                    }
                    else
                    {
                        <span class="nv-oauth-name">@nickName</span>
                    }
                </a>
            }
        </div>
    </div>
}

<style>
    .nv-login-oauth {
        box-sizing: border-box;
        width: 100%;
        max-width: 400px;
        margin: var(--nv-sp-4) auto 0;
        padding: var(--nv-sp-5) var(--nv-sp-6) var(--nv-sp-5);
        background: var(--nv-surface);
        border: 1px solid var(--nv-border);
        border-radius: var(--nv-r-lg);
        box-shadow: var(--nv-sh-2);
        font-family: var(--nv-font);
        color: var(--nv-text);
    }

    .nv-oauth-sep {
        position: relative;
        text-align: center;
        font-size: var(--nv-fs-13);
        color: var(--nv-text-3);
        margin-bottom: var(--nv-sp-3);
    }
    .nv-oauth-sep::before,
    .nv-oauth-sep::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 28%;
        height: 1px;
        background: var(--nv-border);
    }
    .nv-oauth-sep::before { left: 0; }
    .nv-oauth-sep::after { right: 0; }

    .nv-oauth-list { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--nv-sp-3); }

    .nv-oauth-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border: 1px solid var(--nv-border);
        border-radius: var(--nv-r-md);
        background: var(--nv-surface);
        text-decoration: none;
        transition: border-color var(--nv-dur-fast), box-shadow var(--nv-dur-fast);
    }
    .nv-oauth-item:hover {
        border-color: var(--nv-primary);
        box-shadow: var(--nv-sh-focus);
    }
    .nv-oauth-item img { width: 32px; height: 32px; object-fit: contain; }
    .nv-oauth-name {
        font-size: var(--nv-fs-13);
        color: var(--nv-text-2);
        max-width: 52px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>
