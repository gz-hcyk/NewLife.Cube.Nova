@model XCode.Membership.User
@{
    ViewBag.Title = "个人资料";
}
@using System.Linq;
@using System.Reflection;
@using NewLife;
@using XCode;
@using XCode.Configuration;
@using NewLife.Cube.Entity;
@using NewLife.Cube;
@{
    var fact = EntityFactory.CreateFactory(ViewData.ModelMetadata.ModelType);
    var user = Model as IUser;
}
<div class="nv-card">
    <div class="nv-card-head">
        <div class="nv-card-title">个人资料</div>
    </div>
    <div class="nv-card-body">
        @await Html.PartialAsync("_User_Nav")
        @if (ViewBag.StatusMessage != null)
        {
            var bad = ViewData.ModelState.Values.Any(st => st.Errors.Count > 0);
            <div class="nv-notice @(bad ? "nv-notice-danger" : "nv-notice-success")" role="@(bad ? "alert" : "status")" style="margin-bottom:var(--nv-sp-3)">
                <i class="nv-ico nv-notice-ico" data-nv-ico="@(bad ? "alert" : "check")" aria-hidden="true"></i>
                <div class="nv-notice-body">
                    <div class="nv-notice-title">@ViewBag.StatusMessage</div>
                </div>
                <button type="button" class="nv-notice-close" onclick="var n=this.closest('.nv-notice'); if(n) n.remove();" aria-label="关闭">&times;</button>
            </div>
        }
        @using (Html.BeginForm("Info", null, new { id = Model[fact.Unique.Name] }, FormMethod.Post, null, new { enctype = "multipart/form-data" }))
        {
            if (ViewData.ModelState.Values.Any(st => st.Errors.Count > 0))
            {
                <div class="nv-notice nv-notice-danger" role="alert" style="margin-bottom:var(--nv-sp-3)">
                    <i class="nv-ico nv-notice-ico" data-nv-ico="alert" aria-hidden="true"></i>
                    <div class="nv-notice-body">
                        @foreach (var item in ViewData.ModelState.Values)
                        {
                            foreach (var error in item.Errors)
                            {
                                <div class="nv-notice-text">@error.ErrorMessage</div>
                            }
                        }
                    </div>
                </div>
            }
            <div class="nv-form-grid">
                @if (!user.Avatar.IsNullOrEmpty())
                {
                    <div class="nv-field">
                        <label class="nv-field-label">头像</label>
                        <div class="nv-field-ctl">
                            <img src="@user.GetAvatarUrl()" style="max-width:120px;max-height:120px;border-radius:var(--nv-r-md);object-fit:cover" />
                        </div>
                    </div>
                }
                <div class="nv-field">
                    <label class="nv-field-label">名称</label>
                    <div class="nv-field-ctl">
                        <input class="nv-input" value="@user.Name" disabled="disabled" />
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">显示名</label>
                    <div class="nv-field-ctl">
                        @Html.ForEditor("DisplayName")
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">性别</label>
                    <div class="nv-field-ctl">
                        @Html.ForEditor("Sex", user.Sex)
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">邮件</label>
                    <div class="nv-field-ctl">
                        @Html.ForEditor("Mail")
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">手机</label>
                    <div class="nv-field-ctl">
                        @Html.ForEditor("Mobile")
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">代码</label>
                    <div class="nv-field-ctl">
                        @Html.ForEditor("Code")
                    </div>
                    <div class="nv-field-hint">@Html.ForDescription("Code")</div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">生日</label>
                    <div class="nv-field-ctl">
                        @Html.ForEditor("Birthday")
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">角色</label>
                    <div class="nv-field-ctl">
                        <div>@String.Join("、", user.Roles.Select(r => r + ""))</div>
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">部门</label>
                    <div class="nv-field-ctl">
                        <div>@((user as User).DepartmentName)</div>
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label" for="Avatar">头像</label>
                    <div class="nv-field-ctl">
                        <div class="nv-file">
                            <input accept="image/*" id="Avatar" name="Avatar" type="file" class="nv-file-hidden" onchange="var n=this.files&&this.files[0]?this.files[0].name:'';var s=document.getElementById('AvatarFileName');if(s)s.textContent=n||'未选择文件';" />
                            <label class="nv-btn" for="Avatar">选择文件</label>
                            <span class="nv-file-name" id="AvatarFileName">未选择文件</span>
                        </div>
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">登录次数</label>
                    <div class="nv-field-ctl">
                        <div>@user.Logins</div>
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">最后登录</label>
                    <div class="nv-field-ctl">
                        <div>@user.LastLogin.ToFullString("")</div>
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">最后登录IP</label>
                    <div class="nv-field-ctl">
                        <div>@user.LastLoginIP</div>
                    </div>
                </div>
                <div class="nv-col-full">
                    <div class="nv-field">
                        <label class="nv-field-label">备注</label>
                        <div class="nv-field-ctl">
                            @Html.ForEditor("Remark")
                        </div>
                    </div>
                </div>
            </div>
            <div class="nv-form-actions">
                <button type="submit" class="nv-btn nv-btn-primary"><i class="nv-ico nv-ico-sm" data-nv-ico="save"></i>保存</button>
                <button type="button" class="nv-btn" onclick="history.go(-1);"><i class="nv-ico nv-ico-sm" data-nv-ico="x"></i>取消</button>
            </div>
        }
    </div>
</div>
