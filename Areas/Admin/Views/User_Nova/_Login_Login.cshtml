@model LoginViewModel
@using NewLife
@using NewLife.Common
@using NewLife.Cube
@using NewLife.Cube.Areas.Admin.Models
@using NewLife.Cube.Nova
@{
    // 登录表单（Nova 观感）。PC（Login.cshtml）与移动端（MLogin.cshtml）共用本局部视图，改一处两端生效。
    //
    // 提交链路契约（与框架 UserController.Login 一致，元素 id 不可改名）：
    //   #username        用户名，可见输入框，带 name，直接提交
    //   #password        密码「可见」输入框，无 name，不参与提交（仅用于取值加密）
    //   #pwd             真正提交的字段（name=password），值为 RSA 密文；后端未下发公钥时退化为明文
    //   #pkey_container  RSA 公钥；为空表示后端未启用加密
    //   #remember        记住我；#login-btn 登录按钮（type=button，避免回车误提交未加密的表单）
    //
    // 明文/密文切换只改 #password 的 type，不改变提交内容，因此不影响 RSA 加密链路。

    var set = Model;
    // DEF-019：Model.Logo 仅 SSO App 会赋值。空则用魔方设置 LoginLogo；仍空则 mark，不请求 /logo.png。
    var settingLogo = CubeSetting.Current.LoginLogo;
    var logo = set?.Logo;
    if (logo.IsNullOrEmpty()) logo = settingLogo;
    // 旧值 /cube/image?id= 改写匿名代理；公开地址直接用。空则仍是 mark。
    // 代理只读魔方设置。SSO 上另一张附件不改写，失败时 onerror 回 mark。
    if (!logo.IsNullOrEmpty())
    {
        var resolved = NovaLoginAsset.ResolveLogo(logo);
        if (resolved == NovaLoginAsset.LogoUrl && !NovaLoginAsset.SameCubeImage(logo, settingLogo))
            resolved = logo.Trim();
        logo = NovaLoginAsset.ApplyPathBase(resolved, p => Url.Content(p));
    }

    var pDic = ViewData["pKey"] == null ? new KeyValuePair<string, string>() : (KeyValuePair<String, String>)ViewData["pKey"];
    var key = pDic.Key;
    var value = pDic.Value;

    // DEF-015：错密等服务端错误只进当前提交所在 pane。Register 动作的 ModelState 留给注册槽，避免两条相同 danger。
    var loginAct = ViewContext.RouteData.Values["action"] as String ?? "";
    var loginOwnsNotice = !loginAct.EqualIgnoreCase("Register");
}
<div class="tab-pane fade in @(loginOwnsNotice ? "active" : "")" id="Login" role="tabpanel">
    <div class="nv-login">
        <div class="nv-login-brand">
            @if (!logo.IsNullOrEmpty())
            {
                <img src="@logo" alt="@set.DisplayName" onerror="this.hidden=true;var n=this.nextElementSibling;if(n)n.hidden=false;" />
                @* 加载失败（401/404）收起裂图，露出与空 Logo 相同的 mark。 *@
                <span class="nv-login-mark" role="img" aria-label="@set.DisplayName" hidden>
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" />
                    </svg>
                </span>
            }
            else
            {
                @* LoginLogo 为空时不请求 /logo.png，改用内嵌标记，避免 404。 *@
                <span class="nv-login-mark" role="img" aria-label="@set.DisplayName">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" />
                    </svg>
                </span>
            }
        </div>
        <div class="nv-login-eyebrow">账号密码登录</div>
        <div class="nv-login-title">登录到 @set.DisplayName</div>

        <form action="@Url.Action("Login", "User", new { r = set.ReturnUrl })" class="cube-login nv-login-form" method="post" id="cube-login">
            <input type="hidden" id="pkey_container" value="@value" />
            @if (loginOwnsNotice && ViewData.ModelState.Values.Any(st => st.Errors.Count > 0))
            {
                <div class="nv-notice nv-notice-danger" role="alert">
                    <div class="nv-notice-body">
                        @foreach (var item in ViewData.ModelState.Values)
                        {
                            foreach (var error in item.Errors)
                            {
                                <div class="nv-notice-text">@error.ErrorMessage</div>
                            }
                        }
                    </div>
                </div>
            }
            @if (set.AllowLogin)
            {
                <input type="hidden" name="pubKey" />
                <input type="hidden" name="pkey" value="@key" />

                <div class="nv-field">
                    <label class="nv-field-label" for="username">用户名</label>
                    <div class="nv-field-ctl">
                        <span class="nv-affix nv-affix-left" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                            </svg>
                        </span>
                        <input type="text" class="nv-input nv-input-affix-l" id="username" name="username" placeholder="用户名 / 邮箱 / 手机 / 编码" autocomplete="username" autofocus>
                    </div>
                </div>

                <div class="nv-field">
                    <label class="nv-field-label" for="password">密码</label>
                    <div class="nv-field-ctl">
                        <span class="nv-affix nv-affix-left" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z" />
                                <path d="M8 11v-4a4 4 0 0 1 8 0v4" />
                            </svg>
                        </span>
                        <input type="password" class="nv-input nv-input-affix-l nv-input-affix-r" id="password" placeholder="密码" autocomplete="current-password">
                        @* 明文/密文切换：type=button 不会触发提交；aria-pressed 供读屏软件识别状态 *@
                        <button type="button" class="nv-eye" id="pwd-eye" aria-controls="password" aria-pressed="false" aria-label="显示密码" title="显示密码">
                            <svg class="nv-eye-ico nv-eye-show" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                            </svg>
                            <svg class="nv-eye-ico nv-eye-hide" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 3l18 18" />
                                <path d="M10.6 5.6c1.1 -.2 2.2 -.3 3.4 -.3c3.6 0 6.6 2 9 6c-.7 1.2 -1.5 2.2 -2.4 3" />
                                <path d="M6.3 6.3c-1.6 1.2 -3 2.9 -3.8 4.7c2.4 4 5.4 6 9 6c1.3 0 2.5 -.2 3.6 -.6" />
                                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                            </svg>
                        </button>
                    </div>
                </div>
                <input type="hidden" id="pwd" name="password" />

                <div class="nv-login-row">
                    <label class="nv-remember" for="remember">
                        <input type="checkbox" id="remember" name="remember" value="true" />
                        <span>记住我</span>
                    </label>
                    @if (set.AllowRegister)
                    {
                        <a href="#Register" data-nv-tab="#Register" class="nv-login-link" aria-selected="false">我要注册</a>
                    }
                </div>

                <button type="button" id="login-btn" class="nv-btn nv-btn-primary nv-login-submit">登录</button>

                @if (!set.LoginTip.IsNullOrEmpty())
                {
                    <div class="nv-notice nv-notice-warning nv-login-tip" role="alert">
                        @Html.Raw(set.LoginTip)
                    </div>
                }
            }
        </form>
    </div>
</div>

@*
   登录卡片样式内联在本局部视图中，使其自包含。颜色 / 圆角 / 阴影只引用 --nv-*，
   不写 fallback（外壳已加载 nova-tokens.css）。注册面板共用 .nv-login。
*@
<style>
    .nv-login {
        box-sizing: border-box;
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
        padding: var(--nv-sp-6) var(--nv-sp-5) var(--nv-sp-5);
        background: var(--nv-surface);
        border: 1px solid var(--nv-border);
        border-radius: var(--nv-r-lg);
        box-shadow: var(--nv-sh-2);
        font-family: var(--nv-font);
        color: var(--nv-text);
    }
    html[data-nv-density="comfortable"] .nv-login,
    html[data-nv-density="cozy"] .nv-login {
        padding: var(--nv-sp-8) var(--nv-sp-6) var(--nv-sp-6);
    }

    .nv-login-brand { text-align: center; margin-bottom: var(--nv-sp-4); }
    .nv-login-brand img { max-height: 56px; max-width: 100%; object-fit: contain; }
    .nv-login-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: var(--nv-r-md);
        background: var(--nv-primary);
        color: var(--nv-on-primary);
    }

    .nv-login-eyebrow {
        text-align: center;
        font-size: var(--nv-fs-12);
        font-weight: var(--nv-fw-semi);
        letter-spacing: .4px;
        color: var(--nv-primary);
        margin-bottom: var(--nv-sp-2);
    }
    .nv-login-title {
        text-align: center;
        font-size: var(--nv-fs-20);
        font-weight: var(--nv-fw-bold);
        color: var(--nv-text);
        margin: 0 0 var(--nv-sp-5);
    }

    .nv-login-form { margin: 0; }

    /* 校验错误走 .nv-notice；间距用令牌。登录页不加载 nova-ui.js，故不放 data-nv-ico。 */
    .nv-login .nv-notice {
        margin: 0 0 var(--nv-sp-4);
    }
    .nv-login .nv-notice-danger {
        background: var(--nv-danger-weak);
        border-left-color: var(--nv-danger);
        color: var(--nv-text);
    }
    .nv-login .nv-notice-danger .nv-notice-text {
        color: var(--nv-text-2);
    }

    .nv-login .nv-field { margin-bottom: var(--nv-sp-4); }
    .nv-login .nv-field-label {
        display: block;
        margin-bottom: var(--nv-sp-2);
        font-size: var(--nv-fs-13);
        font-weight: var(--nv-fw-semi);
        color: var(--nv-text-2);
    }
    .nv-login .nv-field-ctl { position: relative; display: block; }

    .nv-login .nv-affix {
        position: absolute;
        left: var(--nv-sp-3);
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        color: var(--nv-text-3);
        pointer-events: none;
    }

    .nv-login .nv-input {
        box-sizing: border-box;
        width: 100%;
        height: var(--nv-ctrl-h-lg);
        padding: 0 var(--nv-sp-3);
        border: 1px solid var(--nv-border);
        border-radius: var(--nv-r-md);
        background: var(--nv-surface);
        color: var(--nv-text);
        font-size: var(--nv-fs-14);
        font-family: inherit;
        transition: border-color var(--nv-dur-fast), box-shadow var(--nv-dur-fast);
    }
    .nv-login .nv-input-affix-l { padding-left: 38px; }
    .nv-login .nv-input-affix-r { padding-right: 44px; }
    .nv-login .nv-input::placeholder { color: var(--nv-text-4); }
    .nv-login .nv-input:focus {
        outline: 0;
        border-color: var(--nv-border-focus, var(--nv-primary));
        box-shadow: var(--nv-sh-focus);
    }

    /* 明文 / 密文切换按钮 */
    .nv-login .nv-eye {
        position: absolute;
        right: 6px;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: var(--nv-r-sm);
        background: transparent;
        color: var(--nv-text-3);
        cursor: pointer;
        transition: background var(--nv-dur-fast), color var(--nv-dur-fast);
    }
    .nv-login .nv-eye:hover { background: var(--nv-surface-hover); color: var(--nv-primary); }
    .nv-login .nv-eye:focus-visible { outline: 2px solid var(--nv-primary); outline-offset: 1px; box-shadow: var(--nv-sh-focus); }
    .nv-login .nv-eye .nv-eye-hide { display: none; }
    .nv-login .nv-eye.is-on .nv-eye-show { display: none; }
    .nv-login .nv-eye.is-on .nv-eye-hide { display: inline-flex; }
    .nv-login .nv-eye.is-on { color: var(--nv-primary); }

    .nv-login-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: var(--nv-sp-1) 0 var(--nv-sp-4);
        font-size: var(--nv-fs-13);
    }
    .nv-login .nv-remember {
        display: inline-flex;
        align-items: center;
        gap: var(--nv-sp-2);
        color: var(--nv-text-2);
        cursor: pointer;
        user-select: none;
    }
    .nv-login .nv-remember input { width: 15px; height: 15px; margin: 0; accent-color: var(--nv-primary); cursor: pointer; }
    .nv-login .nv-login-link { color: var(--nv-text-link); text-decoration: none; }
    .nv-login .nv-login-link:hover { color: var(--nv-primary); text-decoration: underline; }

    /* 色板走 .nv-btn-primary 契约；这里钉死令牌，避免宿主链接色渗漏。语义名 --nv-grad-primary 的值已是纯色。 */
    .nv-login .nv-login-submit {
        width: 100%;
        height: var(--nv-ctrl-h-lg);
        border: 0;
        border-radius: var(--nv-r-md);
        background: var(--nv-grad-primary);
        color: var(--nv-on-primary);
        box-shadow: var(--nv-sh-primary);
        font-size: var(--nv-fs-14);
        font-weight: var(--nv-fw-semi);
        cursor: pointer;
    }
    .nv-login .nv-login-submit:hover:not(:disabled) {
        background: var(--nv-grad-primary-hover);
        color: var(--nv-on-primary);
    }

    .nv-login .nv-login-tip {
        margin: var(--nv-sp-4) 0 0;
        padding: var(--nv-sp-3);
        font-size: var(--nv-fs-13);
        line-height: var(--nv-lh-body);
        border: 1px solid var(--nv-border);
        border-left: 3px solid var(--nv-warning);
        border-radius: var(--nv-r-sm);
        background: var(--nv-warning-weak);
        color: var(--nv-text-2);
    }

    @@media (max-width: 420px) {
        .nv-login { padding: var(--nv-sp-6) var(--nv-sp-4) var(--nv-sp-5); }
    }
</style>
