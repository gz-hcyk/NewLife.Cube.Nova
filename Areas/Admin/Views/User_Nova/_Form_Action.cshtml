@using XCode.Membership;
@using NewLife.Cube;
@{
    var entity = Model as IEntity;
    // 与 Views/Nova/_Form_Action 一致：以路由 Action 判定新增。
    // entity.IsNullKey 对 Int32 主键（0）会误判成新增，编辑页应显示「保存」。
    var act = ViewContext.RouteData.Values["action"] as String;
    var isNew = act.EqualIgnoreCase("Add");
}
@* 用户表单操作条（Nova 覆写）。
   保存=主按钮；取消=中性描边（回退用 history.back）；清空密码=弱操作。 *@
@if (this.Has(PermissionFlags.Insert, PermissionFlags.Update))
{
    <div class="nv-form-actions" style="margin:0">
        @if (!isNew)
        {
            <a href="~/Admin/User/ClearPassword/@entity["ID"]" class="nv-btn nv-btn-sm" title="数据库为空密码时，任何密码均可登录">清空密码</a>
        }
        <span class="nv-toolbar-spacer"></span>
        <button type="submit" class="nv-btn nv-btn-primary">@(isNew ? "新增" : "保存")</button>
        <button type="button" class="nv-btn" onclick="history.back();">取消</button>
    </div>
}
