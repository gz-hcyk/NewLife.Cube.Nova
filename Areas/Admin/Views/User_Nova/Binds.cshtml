@model BindsModel
@{
    ViewBag.Title = "第三方授权";
}
@using System.Linq;
@using System.Reflection;
@using NewLife;
@using XCode;
@using XCode.Configuration;
@using NewLife.Cube.Entity;
@using NewLife.Cube.Areas.Admin.Models;
@{
    var ms = Model.OAuthItems;
    var binds = Model.Connects;
}
<div class="nv-card">
    <div class="nv-card-head">
        <div class="nv-card-title">第三方授权</div>
    </div>
    <div class="nv-card-body">
        @await Html.PartialAsync("_User_Nav")
        <div class="nv-field">
            <label class="nv-field-label">名称</label>
            <input class="nv-input" value="@Model.Name" disabled="disabled" />
        </div>
        @if (ms.Count > 0)
        {
            <div class="nv-field">
                <label class="nv-field-label">第三方绑定</label>
                <ul class="nv-link-list">
                    @foreach (var mi in ms)
                    {
                        var uc = binds.FirstOrDefault(e => e.Enable && e.Provider.EqualIgnoreCase(mi.Name));
                        if (uc != null)
                        {
                            <li>
                                <span>@mi.Name（已绑定）</span>
                                <a class="nv-link" href="~/Sso/UnBind/@mi.Name" title="取消绑定 @mi.Name">取消绑定</a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <span>@mi.Name（未绑定）</span>
                                <a class="nv-link" href="~/Sso/Bind/@mi.Name" target="_blank" title="绑定 @mi.Name">去绑定</a>
                            </li>
                        }
                    }
                </ul>
            </div>
        }
    </div>
</div>
