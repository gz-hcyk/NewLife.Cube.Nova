@model ChangePasswordModel
@{
    ViewBag.Title = "修改密码";
}
@using System.Linq;
@using System.Reflection;
@using NewLife;
@using XCode;
@using XCode.Configuration;
@using NewLife.Cube.Entity;
@{
    var requireOldPass = Model.SsoName.IsNullOrEmpty();
}
<div class="nv-card">
    <div class="nv-card-head">
        <div class="nv-card-title">修改密码</div>
    </div>
    <div class="nv-card-body">
        @await Html.PartialAsync("_User_Nav")
        @if (ViewBag.StatusMessage != null)
        {
            <div class="nv-alert nv-alert-success">@ViewBag.StatusMessage</div>
        }
        @using (Html.BeginForm("ChangePassword", "User"))
        {
            <div class="nv-form-grid">
                <div class="nv-field">
                    <label class="nv-field-label">名称</label>
                    <div class="nv-field-ctl">
                        <input class="nv-input" value="@Model.Name" disabled="disabled" />
                        @if (!Model.SsoName.IsNullOrEmpty())
                        {
                            <span class="nv-field-hint">登录自 @Model.SsoName</span>
                        }
                    </div>
                </div>
                @if (requireOldPass)
                {
                    <div class="nv-field">
                        <label class="nv-field-label">原密码</label>
                        <div class="nv-field-ctl">
                            <input class="nv-input" name="OldPassword" type="password" autocomplete="off" />
                        </div>
                    </div>
                }
                <div class="nv-field">
                    <label class="nv-field-label">新密码</label>
                    <div class="nv-field-ctl">
                        <input class="nv-input" name="NewPassword" type="password" autocomplete="new-password" />
                    </div>
                </div>
                <div class="nv-field">
                    <label class="nv-field-label">确认密码</label>
                    <div class="nv-field-ctl">
                        <input class="nv-input" name="NewPassword2" type="password" autocomplete="new-password" />
                    </div>
                </div>
            </div>
            <div class="nv-form-actions">
                <button type="submit" class="nv-btn nv-btn-primary"><i class="nv-ico nv-ico-sm" data-nv-ico="save"></i>保存</button>
                <button type="button" class="nv-btn" onclick="history.go(-1);"><i class="nv-ico nv-ico-sm" data-nv-ico="x"></i>取消</button>
            </div>
        }
    </div>
</div>
