@model LoginViewModel
@using NewLife;
@using NewLife.Common;
@using NewLife.Cube.Areas.Admin.Models;
@using NewLife.Cube.Nova;
@{
    // Nova 化登录页外壳（覆盖框架内置 Login.cshtml）。
    // 站点级 Areas 视图优先于框架内置视图，因此本文件一旦存在即生效。
    //
    // 与框架版的差异：
    //   1. 样式：改用 Nova 设计体系（nova-ui.css 令牌 + 卡片内联样式），不再引入 Cube.css。
    //      本页不加载 jQuery / bootstrap.min.js（库内 wwwroot 没有这两份文件）；登录/注册 tab 由原生脚本切换。
    //   2. 布局：左右分栏（品牌展示区 + 登录卡片），移动端自动折叠为单栏卡片。
    //   3. 新增密码明文 / 密文切换（#pwd-eye），只改可见输入框 type，提交链路不变。
    //   4. 主题与密度跟随皮肤偏好（localStorage nova-theme / nova-density），避免登录页与站内观感割裂。
    Layout = null;
    ViewBag.Title = "登录";

    var res = Model.ResourceUrl;
    var brand = Model.DisplayName;
    var year = DateTime.Now.Year;

    // 背景只落左侧 aside。空 / 纯空白用框架 IsNullOrEmpty，不输出 url、不请求默认图。
    var bg = NewLife.Cube.CubeSetting.Current.LoginBackground;
    if (!bg.IsNullOrEmpty()) bg = bg.Trim();
    var hasBg = !bg.IsNullOrEmpty();
    var bgCss = hasBg
        ? bg.Replace("\\", "/").Replace("\"", "%22").Replace("'", "%27").Replace("(", "%28").Replace(")", "%29").Replace(" ", "%20").Replace("\r", "").Replace("\n", "")
        : "";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <script>
        // 主题/密度预设：与皮肤共用 nova-theme、nova-density，必须在样式表之前同步执行。
        // 未设置主题时跟随系统深色模式；密度缺省为紧凑。
        // comfortable / standard 与 nova-ui.js 三档一致，避免刷新时先闪回紧凑再被脚本改回。
        (function () {
            try {
                var t = localStorage.getItem('nova-theme');
                var dark = t === 'dark' ||
                    (t === null && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
                var d = localStorage.getItem('nova-density');
                if (d !== 'cozy' && d !== 'comfortable' && d !== 'standard' && d !== 'compact') d = 'compact';
                document.documentElement.setAttribute('data-nv-density', d);
            } catch (e) {}
        })();
    </script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - @SysConfig.Current.DisplayName</title>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Nova 设计令牌（唯一权威源）与组件层（卡片与品牌区样式在本页及 _Login_Login.cshtml 内自包含） -->
    <link href="@NovaSkin.WithVersion(Url.Content("~/Content/nova/nova-tokens.css"))" rel="stylesheet" />
    <link href="@NovaSkin.WithVersion(Url.Content("~/Content/nova/nova-ui.css"))" rel="stylesheet" />

    <style>
        html, body { height: 100%; }
        body {
            margin: 0;
            background: var(--nv-bg);
            font-family: var(--nv-font);
            color: var(--nv-text);
            -webkit-font-smoothing: antialiased;
        }

        /* ===== 分栏外壳 ===== */
        /* 整页不铺业务背景图。有 LoginBackground 时仅 aside 铺图。 */
        .nv-login-page {
            min-height: 100vh;
            display: flex;
            align-items: stretch;
            background: var(--nv-bg);
        }

        /* 左：品牌展示区（桌面端显示，窄屏隐藏）。空值纯色侧栏；有图时加 --has-bg。 */
        .nv-login-aside {
            position: relative;
            flex: 0 0 44%;
            max-width: 520px;
            overflow: hidden;
            color: var(--nv-text-inverse);
            background: var(--nv-sidebar-bg);
        }
        /* 图层：aside 图 → ::before scrim → .nv-aside-inner。遮罩色只引用令牌。 */
        .nv-login-aside--has-bg {
            background-color: var(--nv-sidebar-bg);
            background-repeat: no-repeat;
            background-size: cover;
            background-position: center;
        }
        .nv-login-aside--has-bg::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background: var(--nv-login-aside-scrim);
        }
        .nv-aside-inner {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
            padding: var(--nv-sp-12) 44px;
            box-sizing: border-box;
        }
        .nv-aside-brand { display: flex; align-items: center; gap: var(--nv-sp-3); }
        .nv-aside-logo {
            width: 44px; height: 44px;
            border-radius: var(--nv-r-lg);
            background: var(--nv-sidebar-hover);
            display: inline-flex; align-items: center; justify-content: center;
            overflow: hidden;
        }
        .nv-aside-logo img { width: 30px; height: 30px; object-fit: contain; }
        .nv-aside-logo--txt {
            font-size: var(--nv-fs-20); font-weight: var(--nv-fw-bold); color: var(--nv-text-inverse);
        }
        .nv-aside-name { font-size: 19px; font-weight: var(--nv-fw-bold); letter-spacing: .5px; color: var(--nv-text-inverse); }

        .nv-aside-hero { margin-top: auto; margin-bottom: auto; }
        .nv-aside-title {
            margin: 0 0 14px;
            font-size: 30px;
            line-height: 1.35;
            font-weight: var(--nv-fw-bold);
            color: var(--nv-text-inverse);
        }
        .nv-aside-sub {
            margin: 0 0 28px;
            font-size: 15px;
            line-height: 1.7;
            color: var(--nv-sidebar-text);
            max-width: 360px;
        }
        .nv-aside-feats { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
        .nv-aside-feats li { display: flex; align-items: flex-start; gap: 10px; font-size: var(--nv-fs-14); color: var(--nv-sidebar-text); }
        .nv-aside-feats svg { flex: none; margin-top: 1px; color: var(--nv-text-inverse); }
        .nv-aside-foot { font-size: var(--nv-fs-12); color: var(--nv-sidebar-text-dim); }

        /* 客户端校验槽：danger 令牌弱底，间距走 --nv-sp-4（元素 id 仍是 nv-login-notice） */
        .nv-login-wrap > .nv-notice-danger {
            background: var(--nv-danger-weak);
            color: var(--nv-text);
        }

        /* 右：登录卡片区 */
        .nv-login-main {
            flex: 1 1 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: var(--nv-sp-8) var(--nv-sp-6);
            box-sizing: border-box;
        }
        .nv-login-wrap { width: 100%; max-width: 400px; }

        /* 未引入 bootstrap.min.css / bootstrap.min.js。tab 显隐只靠 .active，由本页原生脚本切换。 */
        .tab-content > .tab-pane { display: none; }
        .tab-content > .tab-pane.active { display: block; }
        /* DEF-015：.nv-notice 是 display:flex，会盖过浏览器 [hidden]。非当前 pane 的服务端错误条必须自身 display:none，切到注册后登录错误不再可见。 */
        .nv-login-wrap .tab-content > .tab-pane:not(.active) .nv-notice-danger {
            display: none !important;
        }

        /* ===== 移动端折叠为单栏 ===== */
        @@media (max-width: 860px) {
            .nv-login-aside { display: none; }
            .nv-login-main { padding: var(--nv-sp-6) var(--nv-sp-4); }
        }
    </style>
</head>
<body class="nv">
    <div class="nv-login-page">
        <aside class="nv-login-aside@(hasBg ? " nv-login-aside--has-bg" : "")" style="@(hasBg ? $"background-image:url('{bgCss}')" : null)">
            <div class="nv-aside-inner">
                <div class="nv-aside-brand">
                    @if (!brand.IsNullOrEmpty())
                    {
                        <span class="nv-aside-logo">
                            @if (!Model.Logo.IsNullOrEmpty())
                            {
                                <img src="@Model.Logo" alt="@brand" />
                            }
                            else
                            {
                                <span class="nv-aside-logo--txt">@brand.Substring(0, 1)</span>
                            }
                        </span>
                        <span class="nv-aside-name">@brand</span>
                    }
                </div>

                <div class="nv-aside-hero">
                    <h1 class="nv-aside-title">让业务管理<br />更规范、更安心</h1>
                    <p class="nv-aside-sub">统一入口、规范授权、实时洞察——一个平台，掌控全局。</p>
                    <ul class="nv-aside-feats">
                        <li>
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                            <span>多业务集中管控，一站式办理</span>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                            <span>细粒度权限与数据授权管理</span>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                            <span>运行状态实时监测与告警提醒</span>
                        </li>
                    </ul>
                </div>

                <div class="nv-aside-foot">© @year @brand. 保留所有权利。</div>
            </div>
        </aside>

        <main class="nv-login-main">
            <div class="nv-login-wrap">
                <div id="nv-login-notice" class="nv-notice nv-notice-danger" role="alert" hidden style="margin-bottom:var(--nv-sp-4)">
                    <div class="nv-notice-body">
                        <div class="nv-notice-title">无法登录</div>
                        <div class="nv-notice-text" id="nv-login-notice-text"></div>
                    </div>
                </div>
                <div class="tab-content">
                    @await Html.PartialAsync("_Login_Login", Model)@*登录页*@
                    @* 找回密码：框架内置 Login.cshtml 会渲染 _Login_Forgot，但该分部视图不在站点源码中
                       （只在历史部署目录留有残留文件），运行时解析不到即 500，故本页不渲染。
                       且上游登录框里的「忘记密码？」入口本就被注释（历史 _Login_Login.cshtml 57–63 行），
                       没有入口的面板渲染出来也无意义。
                       将来要启用找回密码：需在站点层补 _Login_Forgot.cshtml，并在登录框加回 #Forgot 入口链接。 *@
                    @if (Model.AllowRegister)
                    {
                        @await Html.PartialAsync("_Login_Register", Model)@*注册页*@
                    }
                    @await Html.PartialAsync("_Login_Login3", Model)@*第三方登录*@
                </div>
            </div>
        </main>
    </div>

    <script src="@res/js/md5.js"></script>
    <script src="@res/js/jsencrypt.min.js"></script>

    <script>
        (function () {
            function showNotice(msg) {
                var box = document.getElementById('nv-login-notice');
                var text = document.getElementById('nv-login-notice-text');
                if (text) text.textContent = msg || '';
                if (box) box.hidden = !msg;
            }

            function activateTab(hash) {
                if (!hash) return;
                if (hash.charAt(0) !== '#') hash = '#' + hash;
                var pane = document.getElementById(hash.substring(1));
                if (!pane || !pane.classList.contains('tab-pane')) return;
                var panes = document.querySelectorAll('.tab-content > .tab-pane');
                for (var i = 0; i < panes.length; i++) {
                    panes[i].classList.toggle('active', panes[i] === pane);
                }
                var triggers = document.querySelectorAll('a[data-nv-tab]');
                for (var j = 0; j < triggers.length; j++) {
                    var h = triggers[j].getAttribute('data-nv-tab') || triggers[j].getAttribute('href') || '';
                    if (h && h.charAt(0) !== '#') h = '#' + h;
                    triggers[j].setAttribute('aria-selected', h === hash ? 'true' : 'false');
                }
            }

            document.addEventListener('click', function (e) {
                var a = e.target && e.target.closest ? e.target.closest('a[data-nv-tab], a.nv-login-link[href^="#"]') : null;
                if (!a) return;
                var hash = a.getAttribute('data-nv-tab') || a.getAttribute('href') || '';
                if (hash && hash.charAt(0) !== '#') hash = '#' + hash;
                if (!hash || hash === '#') return;
                e.preventDefault();
                activateTab(hash);
            });
            // 无 hash 时尊重服务端标出的当前 pane（注册失败应停在 #Register，而不是被脚本拉回登录）。
            var bootHash = location.hash;
            if (!bootHash) {
                var bootPane = document.querySelector('.tab-content > .tab-pane.active');
                bootHash = bootPane && bootPane.id ? ('#' + bootPane.id) : '#Login';
            }
            activateTab(bootHash);

            var pwd = document.getElementById('password');
            var eye = document.getElementById('pwd-eye');

            // ① 密码明文 / 密文切换
            //    仅切换可见输入框 type；提交值始终来自 #pwd（RSA 密文或明文），故不影响加密链路。
            if (pwd && eye) {
                eye.addEventListener('click', function () {
                    var show = pwd.type === 'password';
                    pwd.type = show ? 'text' : 'password';

                    var label = show ? '隐藏密码' : '显示密码';
                    eye.setAttribute('aria-pressed', show ? 'true' : 'false');
                    eye.setAttribute('aria-label', label);
                    eye.title = label;
                    eye.classList.toggle('is-on', show);

                    // 保持焦点并把光标移到末尾，避免切换后输入位置丢失
                    pwd.focus();
                    if (show) {
                        try { pwd.setSelectionRange(pwd.value.length, pwd.value.length); } catch (e) { }
                    }
                });
            }

            // ② 登录提交：#password（可见，无 name）→ 可选 RSA 加密 → #pwd（隐藏，name=password）
            function encryptPwd(p) {
                var rsa = new JSEncrypt();
                rsa.setPublicKey(document.getElementById('pkey_container').value);
                return rsa.encrypt(p);
            }

            function submitLogin() {
                var username = document.getElementById('username');
                var password = document.getElementById('password');
                var hidden = document.getElementById('pwd');
                var pkey = document.getElementById('pkey_container');

                if (!username || !username.value) { showNotice('请输入用户名'); username && username.focus(); return; }
                if (!password || !password.value) { showNotice('请输入密码'); password && password.focus(); return; }

                if (hidden) {
                    var key = pkey ? pkey.value : '';
                    // 后端未下发公钥时不做加密，与框架原逻辑一致
                    hidden.value = (key && key.length > 0 && window.JSEncrypt) ? encryptPwd(password.value) : password.value;
                }

                document.getElementById('cube-login').submit();
            }

            var btn = document.getElementById('login-btn');
            if (btn) btn.addEventListener('click', submitLogin);

            // ③ 回车提交（表单内无 submit 按钮，浏览器不会自动提交，这里显式兜底）
            var form = document.getElementById('cube-login');
            if (form) {
                form.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.keyCode === 13) {
                        e.preventDefault();
                        submitLogin();
                    }
                });
            }
        })();
    </script>
</body>
</html>
