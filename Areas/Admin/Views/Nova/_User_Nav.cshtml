@using NewLife;
@using NewLife.Cube;
@{
    var path = Context.Request.Path + "";

    var user = ManageProvider.User;
    var currentId = user?.ID ?? 0;
    var userId = Context.Request.Query["userId"].ToInt(0);
    if (userId == 0 && path.StartsWithIgnoreCase("/Admin/User/Detail", "/Admin/User/Edit"))
    {
        userId = Context.Request.Query["Id"].ToInt(0);
        // 路由形式 /Admin/User/Edit/{id}，主键在路由值而不是查询参数
        if (userId == 0) userId = (ViewContext.RouteData.Values["id"] + "").ToInt();
    }
    if (userId == 0) userId = currentId;

    // 非系统角色只能查看本人：与列表页数据权限口径一致，禁止经 ?userId= 深链窥探他人
    if (user == null || !user.Roles.Any(e => e.IsSystem)) userId = currentId;

    // 标签名取目标用户，而不是当前登录用户
    user = XCode.Membership.User.FindByID(userId);

    var dic = new Dictionary<String, Object>();
    if (userId == currentId)
    {
        dic["基本信息"] = "/Admin/User/Info";
        dic["修改密码"] = "/Admin/User/ChangePassword";
        dic["第三方授权"] = "/Admin/User/Binds";
        dic["租户信息"] = "/Admin/User/TenantSetting";
    }
    // 用户页对非系统角色只读（资料编辑走用户中心），此处统一指向只读查看页
    dic[user + ""] = $"/Admin/User/Detail?Id={userId}";
    dic["三方链接"] = $"/Admin/UserConnect?userId={userId}";
    dic["令牌"] = $"/Admin/UserToken?userId={userId}";
    dic["OAuth日志"] = $"/Admin/OAuthLog?userId={userId}";
    dic["日志"] = $"/Admin/Log?userId={userId}";
    dic["通知记录"] = $"/Admin/NotificationRecord?userId={userId}&channel=InApp";
}
<nav class="nv-tabnav" aria-label="用户中心">
    @foreach (var item in dic)
    {
        var url = item.Value + "";
        var p = url.IndexOf('?');
        var v = p > 0 ? url.Substring(0, p) : url;
        // 用户标签指向查看页；用户编辑页（管理入口）同样点亮该标签
        var on = path.EqualIgnoreCase(v) || (v.EqualIgnoreCase("/Admin/User/Detail") && path.StartsWithIgnoreCase("/Admin/User/Edit"));
        <a class="nv-tabnav-item @(on ? "is-active" : "")" href="@url" aria-current="@(on ? "page" : null)">@item.Key</a>
    }
</nav>
