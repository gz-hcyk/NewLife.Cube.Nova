@using NewLife.Cube.Extensions
@using NewLife.Cube.Entity
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;
}
@* 日志列表自定义搜索（Nova 覆写）：类别/操作下拉 + 成功失败 + 用户 + 时间范围，统一 .nv-field 栅格 *@
<div class="nv-field">
    <label class="nv-field-label" for="category">类别</label>
    <div class="nv-field-ctl">
        @Html.DropDownList("category", new SelectList(Log.FindAllCategoryName(), "Key", "Value", page["category"]), "全部",
            new Dictionary<String, Object> { ["class"] = "nv-select", ["onchange"] = "this.form.submit();" })
    </div>
</div>
<div class="nv-field">
    <label class="nv-field-label" for="act">操作</label>
    <div class="nv-field-ctl">
        @Html.DropDownList("act", new SelectList(Log.FindAllActionName(), "Key", "Value", page["act"]), "全部",
            new Dictionary<String, Object> { ["class"] = "nv-select", ["onchange"] = "this.form.submit();" })
    </div>
</div>
@await Html.PartialAsync("_Enable", "success")
@await Html.PartialAsync("_SelectUser", new SelectUserModel { Id = "userId", UserId = page["userId"].ToInt(-1) })
@await Html.PartialAsync("_DateRange")
