@using NewLife;
@{
    var msg = ViewBag.StatusMessage as String;

    // 表单页标题：页眉（nv-page-head）移除后，在表单区顶部提示当前操作（如「编辑用户」）
    // 新增/编辑以路由 Action 为准：框架按 Add/Edit 分别渲染 AddForm/EditForm，
    // 而 entity.IsNullKey 对 Int32 主键（0 值）判定不可靠，不可作为依据
    var formTitle = ViewBag.Title as String;
    var act = ViewContext.RouteData.Values["action"] as String;
    var isNew = act.EqualIgnoreCase("Add");
}
@if (!formTitle.IsNullOrEmpty())
{
    <div class="nv-form-title">@(isNew ? "添加" : "编辑")@formTitle</div>
}
@if (!msg.IsNullOrEmpty())
{
    // 状态提示条：与通用通知条（.nv-notice）同构，但只做「就地关闭」，
    // 不走 24h 免打扰（表单提示每次提交都可能不同，缓存会误伤）。
    var bad = ViewData.ModelState.Values.Any(st => st.Errors.Count > 0);
    <div class="nv-notice @(bad ? "nv-notice-danger" : "nv-notice-success")" role="@(bad ? "alert" : "status")" style="margin-bottom:var(--nv-sp-3)">
        <i class="nv-ico nv-notice-ico" data-nv-ico="@(bad ? "alert" : "check")" aria-hidden="true"></i>
        <div class="nv-notice-body">
            <div class="nv-notice-title">@msg</div>
        </div>
        <button type="button" class="nv-notice-close" onclick="var n=this.closest('.nv-notice'); if(n) n.remove();" aria-label="关闭">&times;</button>
    </div>
}
