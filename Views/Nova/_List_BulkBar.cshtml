@using NewLife;
@using NewLife.Cube;
@using XCode;
@using XCode.Configuration;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;

    // 批量启用/禁用自动注入条件与 _List_Toolbar 保持一致：
    // 依赖 Context.Items["IsDefaultBatch"]（由 _List_Toolbar_Batch 在工具栏阶段设置），
    // 本 partial 在工具栏之后渲染，标记已就位。
    var hasEnableField = Context.Items.ContainsKey("IsDefaultBatch")
        && fact?.Table?.FindByName("Enable") is FieldItem enableFi
        && enableFi.Type == typeof(Boolean);
}
@if (set.EnableSelect)
{
    @* 批量操作条：勾选后出现（.is-on 由 nova-ui.js 的 nv.refreshBulk 驱动，计数写入 .nv-bulkbar-count b）。
       按钮沿用 data-action="action" 契约，与工具栏原实现一致，仅位置移入本条。 *@
    <div class="nv-bulkbar" role="region" aria-label="批量操作">
        <span class="nv-bulkbar-count">已选 <b>0</b> 项</span>
        <div class="nv-bulkbar-actions">
            @if (hasEnableField)
            {
                <button type="button" class="nv-btn nv-btn-sm" data-action="action" data-url="@Url.Action("EnableSelect")" data-fields="keys" disabled>批量启用</button>
                <button type="button" class="nv-btn nv-btn-sm" data-action="action" data-url="@Url.Action("DisableSelect")" data-fields="keys" disabled>批量禁用</button>
            }
            <button type="button" class="nv-btn nv-btn-sm nv-btn-danger" data-action="action" data-url="@Url.Action("DeleteSelect")" data-method="post" data-fields="keys" data-confirm="该操作将删除选中数据并不可恢复！确认删除？" disabled>批量删除</button>
            <button type="button" class="nv-btn nv-btn-sm" data-nv-bulk-clear>取消选择</button>
        </div>
    </div>
    <script>
        (function () {
            'use strict';
            var btn = document.querySelector('[data-nv-bulk-clear]');
            if (!btn) return;
            btn.addEventListener('click', function () {
                var table = document.querySelector('.nv-table');
                if (!table) return;
                var boxes = table.querySelectorAll('tbody input[type=checkbox]');
                for (var i = 0; i < boxes.length; i++) boxes[i].checked = false;
                // 冒泡 change 交给工具栏的同步逻辑：按钮启停 + 批量条显隐
                if (boxes.length) boxes[0].dispatchEvent(new Event('change', { bubbles: true }));
            });
        })();
    </script>
}
