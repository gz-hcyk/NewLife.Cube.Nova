@using NewLife;
@{
    // 顶栏状态条与本 notice 二选一：有真正校验失败时只留这一条中文。
    var text = "";
    if (NovaForm.HasRealErrors(ViewData.ModelState))
    {
        text = NovaForm.PageFailureText(ViewData.ModelState, ViewBag.Fields as System.Collections.IEnumerable);
        if (text.IsNullOrEmpty()) text = "提交失败";
    }
}
@if (!text.IsNullOrEmpty())
{
    <div class="nv-card nv-mb-3">
        <div class="nv-card-body nv-pt-3">
            <div class="nv-notice nv-notice-danger" role="alert" style="margin-bottom:0">
                <i class="nv-ico nv-notice-ico" data-nv-ico="alert" aria-hidden="true"></i>
                <div class="nv-notice-body">
                    <div class="nv-notice-text">@text</div>
                </div>
            </div>
        </div>
    </div>
}
