@model SelectUserModel
@using NewLife;
@using NewLife.Web;
@using XCode;
@using System.Linq;
@using NewLife.Cube.ViewModels;
@{
    var id = Model.Id;
    var page = ViewBag.Page as Pager;

    if (id.IsNullOrEmpty()) { id = "userId"; }
    var userId = Model.UserId;
    // page ???????? dynamic string????? .ToInt()
    if (userId <= 0 && page != null)
        Int32.TryParse(Convert.ToString(page[id]), out userId);
    var showValue = XCode.Membership.User.FindByID(userId)?.ToString();

    var set = NewLife.Cube.CubeSetting.Current;
    var res = set.ResourceUrl;
    if (String.IsNullOrEmpty(res)) res = "/Content";
    res = res.TrimEnd('/');
}
@* ???????? bootstrap-suggest?jQuery ???????????? .nv-field / .nv-input?????????? *@
<div class="nv-field">
    <label class="nv-field-label" for="@(id)_select">????</label>
    <div class="nv-field-ctl">
        <i class="nv-ico nv-ico-sm nv-input-affix" data-nv-ico="users"></i>
        <input type="hidden" name="@id" id="@id" value="@userId" />
        <input type="text" class="nv-input" id="@(id)_select" placeholder="????" value="@showValue" autocomplete="off" />
    </div>
</div>
<script src="@res/bootstrap-suggest.js"></script>
<script type="text/javascript">
    $(function () {
        $("#@(id)_select").bsSuggest({
            url: "/cube/UserSearch?roleid=@Model.RoleId&department=@Model.DepartmentId&key=",
            getDataMethod:"url",
            effectiveFieldsAlias: { id:"??",code:"??",name: "??",displayName:'??',departmentName:'??'},
            ignorecase: true,
            showHeader: true,
            delayUntilKeyup: true,
            hideOnSelect: true,
            idField: "id",
            showBtn: false,
            keyField: "name",
            clearable: true,
            searchingTip: '???...',
            allowNoKeyword: true,
            delay: 500,
            emptyTip: '???',
            containerValueId: '@id',
            fnProcessData: function (result) {
                dt = {};
                dt.value = result.data;
                return dt;
            }
        }).on('onSetSelectValue', function (e, keyword, data) {
            $('#@id').val(keyword.id);
        }).on('onUnsetSelectValue', function () {
            $('#@id').val('');
        });
    });
</script>
