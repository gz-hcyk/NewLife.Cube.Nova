@using NewLife;
@using System.ComponentModel;
@using System.Reflection;
@using NewLife.Reflection;
@using NewLife.Serialization;
@{
    // 强制设置Layout，因为最终项目可能给前端设置Layout，会覆盖影响魔方内部页面
    var theme = NewLife.Cube.CubeSetting.Current.Theme;
    if (String.IsNullOrEmpty(theme)) theme = "ACE";

    Layout = "~/Views/" + theme + "/_Layout.cshtml";

    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;

    var obj = (Object)Model;
    var list = ViewBag.Fields as IList<DataField>;
    var dic = list
        .GroupBy(e => e.Category + "")
        .ToDictionary(e => e.Key.IsNullOrEmpty() ? "默认" : e.Key, e => e.ToList());
}
@if (!set.NavView.IsNullOrEmpty())
{
    <div class="nv-mb-3">
        @await Html.PartialAsync(set.NavView)
    </div>
}
<div class="nv-card">
    @using (Html.BeginForm("Update", null, FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @* 模型级错误只留一条中文。字段错误在各 _ObjectForm_Field，至多一行。 *@
        var modelLevel = NovaForm.ModelLevelFailureText(ViewData.ModelState);
        if (!modelLevel.IsNullOrEmpty())
        {
            <div class="nv-notice nv-notice-danger" role="alert" style="margin:var(--nv-sp-4) var(--nv-sp-4) 0">
                <i class="nv-ico nv-notice-ico" data-nv-ico="alert" aria-hidden="true"></i>
                <div class="nv-notice-body">
                    <div class="nv-notice-text">@modelLevel</div>
                </div>
            </div>
        }
        if (dic.Count > 1)
        {
            var i = 0;
            var j = 0;
            <div class="nv-card-body nv-pb-0 nv-tabs-host">
                <ul class="nav nav-tabs" role="tablist">
                    @foreach (var item in dic)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(i == 0 ? "active" : "")" type="button" id="nvObjTab@(i)" data-bs-toggle="tab" data-bs-target="#nvObj@(i)" role="tab" aria-controls="nvObj@(i)" aria-selected="@(i == 0 ? "true" : "false")">@item.Key</button>
                        </li>
                        i++;
                    }
                </ul>
            </div>
            <div class="tab-content">
                @foreach (var group in dic)
                {
                    <div class="tab-pane fade @(j == 0 ? "show active" : "")" id="nvObj@(j)" role="tabpanel" aria-labelledby="nvObjTab@(j)">
                        <div class="nv-card-body">
                            @await Html.PartialAsync("_ObjectForm_Flow", new Tuple<Object, IList<DataField>>(obj, group.Value))
                        </div>
                    </div>
                    j++;
                }
            </div>
        }
        else
        {
            <div class="nv-card-body">
                @foreach (var item in dic)
                {
                    @await Html.PartialAsync("_ObjectForm_Flow", new Tuple<Object, IList<DataField>>(obj, item.Value))
                }
            </div>
        }
        if (this.Has(PermissionFlags.Update))
        {
            <div class="nv-card-foot">
                <div class="nv-form-actions">
                    <button type="submit" class="nv-btn nv-btn-primary"><i class="nv-ico nv-ico-sm" data-nv-ico="save"></i>保存</button>
                    <button type="button" class="nv-btn" onclick="history.go(-1);"><i class="nv-ico nv-ico-sm" data-nv-ico="x"></i>取消</button>
                </div>
            </div>
        }
    }
</div>
@{
    // 主题色方案联动：字段带 ColorMap 时，选择方案自动填充目标颜色输入框（与框架 Shared 版对齐）
    var schemeField = list.FirstOrDefault(e => e.Properties.ContainsKey("ColorMap"));
}
@if (schemeField != null)
{
    var colorMap = schemeField.Properties["ColorMap"];
    var colorTargets = (schemeField.Properties["ColorTargets"] + "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(e => e.Trim()).ToArray();
    <script>
        (function () {
            var map = @Html.Raw(colorMap);
            var targets = @Html.Raw(JsonHelper.ToJson(colorTargets));
            var sel = document.getElementById('@schemeField.Name');
            if (!sel) return;
            var apply = function (key) {
                var v = map[key];
                if (!v) return;
                var colors = String(v).split(',');
                targets.forEach(function (id, i) {
                    var el = document.getElementById(id);
                    if (el) el.value = (colors[i] || '').trim();
                    var txt = document.getElementById(id + '_text');
                    if (txt) txt.value = (colors[i] || '').trim();
                });
            };
            apply(sel.value);
            sel.addEventListener('change', function () { apply(this.value); });
        })();
    </script>
}
