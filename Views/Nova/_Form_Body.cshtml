@using NewLife;
@using XCode;
@using XCode.Configuration;
@{
    var entity = Model as IEntity;
    var fields = ViewBag.Fields as FieldCollection;
    var groupFields = fields.GroupByCategory(entity);
}
@* 字段可见性、并排与 GroupView 在 _Form_Flow。分组只决定页签。 *@
@if (groupFields.Count > 1)
{
    var i = 0;
    var j = 0;
    @* 多分组：一张外层卡片内的 BS5 选项卡（与 ObjectForm 同构，id 用 nvForm*）。
       分类名作页签；字段可见性、GroupView / _Form_Group 与原先一致。页级提示与操作栏不进页签。 *@
    <div class="nv-card nv-mb-3">
        <div class="nv-card-body nv-pb-0 nv-tabs-host">
            <ul class="nav nav-tabs" role="tablist">
                @foreach (var item in groupFields)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(i == 0 ? "active" : "")" type="button" id="nvFormTab@(i)" data-bs-toggle="tab" data-bs-target="#nvForm@(i)" role="tab" aria-controls="nvForm@(i)" aria-selected="@(i == 0 ? "true" : "false")">@item.Key</button>
                    </li>
                    i++;
                }
            </ul>
        </div>
        <div class="tab-content">
            @foreach (var group in groupFields)
            {
                <div class="tab-pane fade @(j == 0 ? "show active" : "")" id="nvForm@(j)" role="tabpanel" aria-labelledby="nvFormTab@(j)">
                    <div class="nv-card-body">
                        @await Html.PartialAsync("_Form_Flow", new Tuple<IEntity, IEnumerable<DataField>>(entity, group.Value))
                    </div>
                </div>
                j++;
            }
        </div>
    </div>
}
else
{
    <div class="nv-card nv-mb-3">
        <div class="nv-card-body">
            @await Html.PartialAsync("_Form_Flow", new Tuple<IEntity, IEnumerable<DataField>>(entity, fields))
        </div>
    </div>
}
