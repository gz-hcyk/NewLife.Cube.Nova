@using NewLife;
@using NewLife.Web;
@using XCode;
@using XCode.Configuration;
@{
    var fact = ViewBag.Factory as IEntityFactory;
    var page = ViewBag.Page as Pager;
    var fields = ViewBag.Fields as FieldCollection;
    var ukey = fact.Unique;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;

    // 树形自动判定：列表字段（含映射列）中出现 ParentID 即按树形表格渲染。
    // ParentID 常被从列表隐藏、仅以 ParentName(MapField=ParentID) 映射列出现，故两种形态都要认。
    // 父键列取 MapField（映射列指向真实列），无映射时取字段自身名
    var treeParentField = fields.FirstOrDefault(f => f.Name.EqualIgnoreCase("ParentID") ||
        (!f.MapField.IsNullOrEmpty() && f.MapField.EqualIgnoreCase("ParentID")));
    var treeParentColumn = treeParentField == null ? null :
        (!treeParentField.MapField.IsNullOrEmpty() ? treeParentField.MapField : treeParentField.Name);
    var isTree = treeParentField != null && ukey != null && Model is IEnumerable<IEntity>;

    // 预计算树形行数据：父指针表、有子节点集合。数据为当前页扁平行，前端按 data-nv-tree-* 属性组树
    IDictionary<String, String> treeParentOf = null;
    ISet<String> treeChildIds = null;
    List<IEntity> treeRows = null;
    if (isTree)
    {
        treeParentOf = new Dictionary<String, String>(StringComparer.OrdinalIgnoreCase);
        foreach (IEntity entity in (IEnumerable<IEntity>)Model)
        {
            var id = entity[ukey.Name];
            if (id == null) continue;
            treeParentOf[id.ToString()] = entity[treeParentColumn]?.ToString();
        }
        treeChildIds = new HashSet<String>(StringComparer.OrdinalIgnoreCase);
        foreach (var kv in treeParentOf)
        {
            if (!kv.Value.IsNullOrEmpty()) treeChildIds.Add(kv.Value);
        }

        // 树序输出：父在前子跟随（原输出按分页排序，子行散落在父行之前，树形不可读）。
        // 兄弟按 Sort 列升序（无则按主键），LINQ OrderBy 稳定，同键保持原相对顺序。
        // 兄弟按 Sort 列升序（无则按主键）。注意 FindByName 返回 FieldItem，其基类 Field
        // 重载了 ==/!= 且返回 Expression（SQL 构造用），判空必须走 Object.ReferenceEquals。
        var sortField = fact.Table.FindByName("Sort") as FieldItem;
        Int64 SortKey(IEntity e)
        {
            Object v = Object.ReferenceEquals(sortField, null) ? e[ukey.Name] : e[sortField.Name];
            return v.ToLong();
        }
        var treeById = new Dictionary<String, IEntity>(StringComparer.OrdinalIgnoreCase);
        foreach (IEntity entity in (IEnumerable<IEntity>)Model)
        {
            var id = entity[ukey.Name]?.ToString();
            if (!id.IsNullOrEmpty()) treeById[id] = entity;
        }
        var treeKidsOf = new Dictionary<String, List<IEntity>>(StringComparer.OrdinalIgnoreCase);
        var treeRoots = new List<IEntity>();
        foreach (IEntity entity in (IEnumerable<IEntity>)Model)
        {
            var pid = entity[treeParentColumn]?.ToString();
            if (!pid.IsNullOrEmpty() && treeById.ContainsKey(pid))
            {
                if (!treeKidsOf.TryGetValue(pid, out var kids)) treeKidsOf[pid] = kids = new List<IEntity>();
                kids.Add(entity);
            }
            else treeRoots.Add(entity);
        }
        foreach (var list in treeKidsOf.Values)
        {
            var sorted = list.OrderBy(SortKey).ThenBy(e => e[ukey.Name].ToLong()).ToList();
            list.Clear(); list.AddRange(sorted);
        }
        // DFS 组装：父行在前、子树紧跟其后，折叠/缩进才连续可读
        treeRows = new List<IEntity>();
        void WalkTree(IEntity e)
        {
            treeRows.Add(e);
            var id = e[ukey.Name]?.ToString();
            if (id.IsNullOrEmpty()) return;
            if (treeKidsOf.TryGetValue(id, out var kids)) foreach (var k in kids) WalkTree(k);
        }
        foreach (var r in treeRoots.OrderBy(SortKey).ThenBy(e => e[ukey.Name].ToLong())) WalkTree(r);
    }

    // 树形切换钮所在列：优先 Name 主字段列，退回首个字符串列；都无时前端退回首个非复选列
    Int32 treeLabelTdIndex = -1;
    if (isTree)
    {
        var labelField = fields.FirstOrDefault(f => f.Name.EqualIgnoreCase("Name"))
            ?? fields.FirstOrDefault(f => f.Type == typeof(String));
        if (labelField != null)
        {
            var idx = 0;
            foreach (var f in fields)
            {
                if (f.Name == labelField.Name)
                {
                    treeLabelTdIndex = idx + (set.EnableSelect && ukey != null ? 1 : 0);
                    break;
                }
                idx++;
            }
        }
    }
    Object rowSource = isTree ? treeRows : Model;

    // 空列表：优先分页总数。已查出总数且 TotalCount > 0 则一定有数据；
    // TotalCount == 0 且本次确实查询了总数（RetrieveTotalCount）才视为空。
    // EnableTotalCount = false 时总数保持 0、当前页仍可能有行，此时只 MoveNext 一次，
    // 避免对 IEnumerable 调用 Count() 整表枚举。
    Boolean listEmpty;
    if (page != null && page.TotalCount > 0)
    {
        listEmpty = false;
    }
    else if (page != null && page.RetrieveTotalCount)
    {
        listEmpty = page.TotalCount == 0;
    }
    else if (rowSource is System.Collections.IEnumerable seq)
    {
        var it = seq.GetEnumerator();
        try { listEmpty = !it.MoveNext(); }
        finally { (it as IDisposable)?.Dispose(); }
    }
    else
    {
        listEmpty = rowSource == null;
    }

    var colCount = fields.Count
        + (set.EnableSelect && ukey != null ? 1 : 0)
        + (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete) ? 1 : 0);
    var canAdd = set.EnableAdd && !set.IsReadOnly && this.Has(PermissionFlags.Insert);

    // 关键字 q（含 POST）或除分页/排序以外的筛选：空结果视为「无匹配」，否则「暂无数据」。
    // 不改动上面的 listEmpty / RetrieveTotalCount / colCount 判定。
    var queryFiltered = NovaList.IsFiltered(Context.Request, page);
}
@if (isTree)
{
    <div class="nv-tree-tools">
        <button type="button" class="nv-btn nv-btn-sm" data-nv-tree-expand="all">全部展开</button>
        <button type="button" class="nv-btn nv-btn-sm" data-nv-tree-expand="none">全部折叠</button>
    </div>
}
<table class="nv-table@(isTree ? " nv-tree-table" : "")"@Html.Raw(isTree && treeLabelTdIndex >= 0 ? " data-nv-tree-label=\"" + treeLabelTdIndex + "\"" : "")>
    <thead>
        <tr>
            @if (set.EnableSelect && ukey != null)
            {
                <th class="nv-th nv-td-sticky" style="width:38px"><input type="checkbox" id="chkAll" data-nv-checkall="keys" title="全选" aria-label="全选本页" /></th>
            }
            @foreach (var item in fields)
            {
                var sortUrl = !item.MapField.IsNullOrEmpty() ? page.GetSortUrl(item.MapField) : page.GetSortUrl(item.Name);
                var df = item as ListField;
                var name = df?.Header ?? item.DisplayName ?? item.Name;
                var title = df?.HeaderTitle ?? item.Description;

                if (item.Type == typeof(DateTime) && item.Services.Count == 0 && df?.GetValue == null)
                {
                    @* 列宽自适应：不再给 DateTime 列强制 min-width，由内容与表格自动布局决定 *@
                    <th class="nv-th nv-td-mid" title="@title"><a href="@Html.Raw(sortUrl)">@name</a></th>
                }
                else if (item.Type == null)
                {
                    <th class="nv-th nv-td-mid" title="@title">@name</th>
                }
                else
                {
                    <th class="nv-th nv-td-mid" title="@title"><a href="@Html.Raw(sortUrl)">@name</a></th>
                }
            }
            @if (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete))
            {
                <th class="nv-th nv-td-mid">操作</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (listEmpty)
        {
            <tr class="nv-empty-row">
                <td colspan="@colCount">
                    <div class="nv-empty" role="status">
                        <div class="nv-empty-ico">
                            <i class="nv-ico" data-nv-ico="@(queryFiltered ? "search" : "folder")" aria-hidden="true"></i>
                        </div>
                        <div class="nv-empty-title">@(queryFiltered ? "无匹配结果" : "暂无数据")</div>
                        <div class="nv-empty-desc">@(queryFiltered ? "当前筛选条件下没有记录，可清空条件后重试。" : "当前列表还没有记录。")</div>
                        @if (queryFiltered)
                        {
                            <div class="nv-empty-actions">
                                <a class="nv-btn nv-btn-sm" href="@Context.Request.Path.Value" title="清空全部筛选与分页条件">
                                    <i class="nv-ico nv-ico-sm" data-nv-ico="refresh" aria-hidden="true"></i>重置
                                </a>
                            </div>
                        }
                        else if (canAdd && page != null)
                        {
                            <div class="nv-empty-actions">
                                @Html.ActionLink("添加", "Add", page.GetRouteValue(), new { @class = "nv-btn nv-btn-primary nv-btn-sm" }.ToDictionary())
                            </div>
                        }
                    </div>
                </td>
            </tr>
        }
        else
        {
        @foreach (var entity in (dynamic)rowSource)
        {
            // 树形行属性：主键、父键、深度（沿父链向上推算）、是否有子节点；平铺列表输出 null
            String treeAttrs = null;
            if (isTree)
            {
                var treeId = (String)entity[ukey.Name]?.ToString();
                var treePid = (String)entity[treeParentColumn]?.ToString();
                var treeDepth = 0;
                var seen = new HashSet<String>(StringComparer.OrdinalIgnoreCase);
                String p = treePid;
                while (!p.IsNullOrEmpty() && treeParentOf.ContainsKey(p) && seen.Add(p) && treeDepth < 64)
                {
                    treeDepth++;
                    p = treeParentOf[p];
                }
                var treeBranch = !treeId.IsNullOrEmpty() && treeChildIds.Contains(treeId) ? 1 : 0;
                treeAttrs = $"data-nv-tree-id=\"{treeId}\" data-nv-tree-parent=\"{treePid}\" data-nv-tree-depth=\"{treeDepth}\" data-nv-tree-branch=\"{treeBranch}\"";
            }
            <tr class="@(fields.GetRowClass?.Invoke(entity))" @Html.Raw(treeAttrs)>
                @if (set.EnableSelect && ukey != null)
                {
                    <td class="nv-td-sticky nv-td-mid"><input type="checkbox" name="keys" value="@entity[ukey.Name]" aria-label="选择该行" /></td>
                }
                @foreach (var item in fields)
                {
                    var df = item as ListField;
                    var txt = "";
                    if (df != null && df.DataVisible != null && !df.DataVisible(entity))
                    {
                        <td></td>
                    }
                    else if (df != null && (txt = df.GetLink(entity, page)) != null)
                    {
                        var tdClass = df.GetTextClass(entity);
                        <td class="@(tdClass ?? "nv-td-mid")">@Html.Raw(txt)</td>
                    }
                    else if (df != null && (txt = df.GetText(entity, page)) != null)
                    {
                        var title = df.GetTitle(entity, page);
                        var tdClass = df.GetTextClass(entity);
                        <td class="@tdClass" title="@title">@Html.Raw(txt)</td>
                    }
                    else
                    {
                        @await Html.PartialAsync("_List_Data_Item", new EntityField(entity, item))
                    }
                }
                @if (this.Has(PermissionFlags.Detail, PermissionFlags.Update, PermissionFlags.Delete))
                {
                    <td class="nv-td-actions">
                        @await Html.PartialAsync("_List_Data_Action", (Object)entity)
                    </td>
                }
            </tr>
        }
        @if (page.State is IEntity entity2)
        {
            @await Html.PartialAsync("_List_Data_Stat", entity2)
        }
        }
    </tbody>
</table>
