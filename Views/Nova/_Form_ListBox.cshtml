@model ListBoxModel
@using NewLife;
@using NewLife.Cube
@using XCode;
@using XCode.Configuration;
@using System.Collections;
@{
    var name = Model.Name;
    var value = Model.Value;
    var type = value.GetType();

    var atts = HtmlHelper.AnonymousObjectToHtmlAttributes(Model.HtmlAttributes);
    // 原生 select[multiple] 需要 Ctrl+Click，对业务用户不友好；Nova 一律渲染为勾选清单（tag 化复选）。
    // 不再依赖 bootstrap-multiselect 插件（皮肤未内置，此前输出裸 select 挤成 4 行小框）。
    var id = atts.ContainsKey("id") ? atts["id"] as String : name;
    if (id.IsNullOrEmpty()) id = name;

    var selectedValues = Model.SelectedValues as String;
    var selectedList = selectedValues?.Split(",");

    IEntityTree treeSample = null;
    if (value is IEnumerable probe)
    {
        foreach (var item in probe)
        {
            treeSample = item as IEntityTree;
            break;
        }
    }

    // 各分支统一收敛为 MultiSelectList，再由下方勾选清单渲染（提交格式与原生 ListBox 完全一致：name 重复出现）
    MultiSelectList msl = null;
    if (treeSample == null)
    {
        if (value is IEnumerable<SelectListItem> selectList)
        {
            msl = new MultiSelectList(selectList, "Value", "Text", selectedList);
        }
        else if (value is IEnumerable data && type.GetElementTypeEx().As(typeof(IEntity)))
        {
            IEntityFactory factory = null;
            var dic = new Dictionary<String, String>();
            foreach (IEntity entity in data)
            {
                if (factory == null) factory = entity.GetType().AsFactory();

                var key = entity[factory.Unique.Name] + "";
                dic[key] = entity + "";
            }
            msl = new MultiSelectList(dic, "Key", "Value", selectedList);
        }
        else if (value is IDictionary dic)
        {
            msl = new MultiSelectList(dic, "Key", "Value", selectedList);
        }
        else if (value is IEnumerable items)
        {
            msl = new MultiSelectList(items, selectedList);
        }
    }
}
@if (treeSample != null)
{
    var treeVd = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);
    treeVd["TreeMultiple"] = true;
    @await Html.PartialAsync("_TreeSelect", Model, treeVd)
}
else if (msl != null)
{
    <div class="nv-checklist-bar">
        <a href="javascript:;" data-nv-checkall="@id">全选</a>
        <a href="javascript:;" data-nv-checknone="@id">清空</a>
    </div>
    <div class="nv-checklist" id="@id" role="group" aria-label="多选列表">
        @foreach (var it in msl)
        {
            <label class="nv-check-item">
                <input type="checkbox" name="@name" value="@it.Value" checked="@it.Selected" />
                <span>@it.Text</span>
            </label>
        }
    </div>
}
