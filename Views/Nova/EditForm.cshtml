@using NewLife;
@using System.Reflection
@using XCode
@using XCode.Configuration
@using Microsoft.AspNetCore.Mvc.Rendering;
@{
    var theme = NewLife.Cube.CubeSetting.Current.Theme;
    if (String.IsNullOrEmpty(theme)) theme = "ACE";

    Layout = "~/Views/" + theme + "/_Layout.cshtml";

    var entity = Model as IEntity;
    var fields = ViewBag.Fields as FieldCollection;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;

    var rv = entity.GetRouteKey();

    Object htmlAttributes = null;
    if (fields != null && fields.Any(e => e.IsAttachment())) htmlAttributes = new { enctype = "multipart/form-data" };
}
@if (!set.NavView.IsNullOrEmpty())
{
    <div class="nv-mb-3">
        @await Html.PartialAsync(set.NavView)
    </div>
}
@* 卡片由 _Form_Body 渲染（单分组一张卡、无页签；多分组同一张卡内 BS5 选项卡）。错误提示独立成卡，在页签外。 *@
@using (Html.BeginForm("Edit", null, rv, FormMethod.Post, null, htmlAttributes))
{
    @await Html.PartialAsync("_Form_Header", entity)
    @await Html.PartialAsync("_Form_Failure")
    @await Html.PartialAsync("_Form_Body", entity)
    @await Html.PartialAsync("_Form_Footer", entity)
    @await Html.PartialAsync("_Form_Action", entity)
}
