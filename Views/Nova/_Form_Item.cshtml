@model EntityField
@using NewLife;
@using NewLife.Cube
@using NewLife.Data;
@using NewLife.Reflection;
@using XCode;
@using XCode.Configuration;
@using System.Collections;
@{
    var entity = Model.Entity;
    var item = Model.Field;

    var fs = ViewBag.Fields as FieldCollection;
    var dataField = fs.GetField(item.Name);
    var dataSource = dataField?.DataSource;
    var itemModel = new ItemModel(item.Name, entity[item.Name], item.Type) { ItemType = item.ItemType, Length = item.Length };

    var itemView = (dataField as FormField)?.ItemView;

    var err = 0;
    if (ViewData.ModelState.TryGetValue(item.Name, out var st) && st != null) { err = st.Errors.Count; }

    // 说明文字：去掉「显示名」前缀与分隔符。
    var des = item.Description;
    if (!des.IsNullOrEmpty() && !item.DisplayName.IsNullOrEmpty() && des.StartsWith(item.DisplayName))
    {
        des = des.Substring(item.DisplayName.Length);
    }
    if (!des.IsNullOrEmpty())
    {
        des = des.TrimStart('.', '。', ',', '，', ';', '；', ':', '：', ' ', '\r', '\n');
    }
    var display = dataField?.DisplayName ?? item.DisplayName;

    // 优化对雪花Id的支持
    if (des.IsNullOrEmpty() && item.Type == typeof(Int64) && itemModel.Value.ToLong() > 700_00000000_00000000)
    {
        var snow = new Snowflake();
        if (snow.TryParse(itemModel.Value.ToLong(), out var time, out _, out _))
        {
            des = time.ToString("yyyy-MM-dd HH:mm:ss.fff");
        }
    }

    // —— 树状下拉判定 ——
    // 1) ItemType 显式指定 tree / treeSelect / treeMultiple
    // 2) 当前实体为 IEntityTree 且字段为 Parent 键
    // 3) DataSource 首项为 IEntityTree
    // 4) 字段名 ParentID 且实体含 ParentID
    Boolean IsTreeEntityType(Type t)
    {
        if (t == null) return false;
        if (typeof(IEntityTree).IsAssignableFrom(t)) return true;
        try
        {
            var f = EntityFactory.CreateFactory(t);
            return f?.Table?.FindByName("ParentID") != null;
        }
        catch { return false; }
    }

    Boolean IsTreeData(Object ds)
    {
        if (ds == null) return false;
        if (ds is IEnumerable<SelectListItem> sl)
            return sl.Any(e => (e.Text + "").IndexOf('\u3000') >= 0 || (e.Text + "").IndexOf('　') >= 0);
        if (ds is IDictionary dic)
        {
            foreach (DictionaryEntry kv in dic)
            {
                var text = kv.Value + "";
                if (text.IndexOf('\u3000') >= 0 || text.IndexOf('　') >= 0) return true;
            }
            return false;
        }
        if (ds is IEnumerable list)
        {
            foreach (var one in list)
            {
                if (one is IEntityTree) return true;
                if (one is IEntity en && IsTreeEntityType(en.GetType())) return true;
                break;
            }
        }
        return false;
    }

    var forceTree = item.ItemType.EqualIgnoreCase("tree", "treeSelect", "treeMultiple", "multipleTree");
    var forceMulti = item.ItemType.EqualIgnoreCase("multipleSelect", "treeMultiple", "multipleTree")
        || (!item.ItemType.EqualIgnoreCase("singleSelect", "tree", "treeSelect") && item.Name.EndsWith("s"));
    var isParentField = false;
    IEntityTreeSetting entityTreeSet = null;
    if (entity is IEntityTree)
    {
        entityTreeSet = entity.GetType().GetValue("Setting") as IEntityTreeSetting;
        isParentField = entityTreeSet != null && entityTreeSet.Parent.EqualIgnoreCase(item.Name);
    }
    if (!isParentField && item.Name.EqualIgnoreCase("ParentID"))
    {
        isParentField = entity.GetType().AsFactory()?.Table?.FindByName("ParentID") != null;
    }
}
<div class="nv-field @(err > 0 ? "has-error" : "")">
    <label class="nv-field-label" for="@item.Name" title="@display">@display</label>
    <div class="nv-field-ctl">
        @if (dataSource != null)
        {
            var ds = dataSource(entity);

            if (TenantContext.CurrentId > 0)
            {
                var roles = Tenant.FindById(TenantContext.CurrentId)?.RoleIds.SplitAsInt();
                if (roles == null && roles.Length == 0)//强制把系统权限清空了
                {
                    ds.Clear();
                }
                else//按照已有的角色组进行分配
                {
                    if (ds is IDictionary<Int32, String> odic)
                    {
                        ds = odic.Where(kvp => roles.Contains(kvp.Key)).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                    }
                }
            }

            if (ds is IDictionary<Int32, String>)
            {
                if (!ds.Contains(-1))
                {
                    ds.Add(-1, "<无>");
                }
            }
            else if (ds is IDictionary<String, String>)
            {
                if (!ds.Contains("-1"))
                {
                    ds.Add("-1", "<无>");
                }
            }

            var useTree = forceTree || IsTreeData(ds);
            var multi = forceMulti || item.ItemType.EqualIgnoreCase("multipleSelect") || (!forceTree && item.Name.EndsWith("s") && !item.ItemType.EqualIgnoreCase("singleSelect"));

            if (useTree)
            {
                Object htmlAtts = multi ? (Object)new { multiple = "multiple", data_multiple = "1" } : null;
                @await Html.PartialAsync(itemView ?? "_Form_TreeSelect", new ListBoxModel(item.Name, ds, itemModel.Value, null, false, htmlAtts))
            }
            else if (item.ItemType.EqualIgnoreCase("singleSelect"))
            {
                @await Html.PartialAsync(itemView ?? "_Form_DropDownList", new ListBoxModel(item.Name, ds, itemModel.Value))
            }
            else if (item.ItemType.EqualIgnoreCase("multipleSelect"))
            {
                @await Html.PartialAsync(itemView ?? "_Form_ListBox", new ListBoxModel(item.Name, ds, itemModel.Value))
            }
            else if (item.Name.EndsWith("s"))
            {
                @await Html.PartialAsync(itemView ?? "_Form_ListBox", new ListBoxModel(item.Name, ds, itemModel.Value))
            }
            else
            {
                @await Html.PartialAsync(itemView ?? "_Form_DropDownList", new ListBoxModel(item.Name, ds, itemModel.Value))
            }
        }
        else
        {
            if (item.ItemType.EqualIgnoreCase("area4"))
            {
                @await Html.PartialAsync("_Area4", Model)
            }
            else if (item.ItemType.EqualIgnoreCase("area3", "area"))
            {
                @await Html.PartialAsync("_Area3", Model)
            }
            else if (item.ItemType.EqualIgnoreCase("area2"))
            {
                @await Html.PartialAsync("_Area2", Model)
            }
            else if (item.ItemType.EqualIgnoreCase("area1"))
            {
                @await Html.PartialAsync("_Area1", Model)
            }
            else if (!item.MapField.IsNullOrEmpty())
            {
                @await Html.PartialAsync(itemView ?? "_Form_Map", Model)
            }
            else if (item.ReadOnly)
            {
                <input class="nv-input" id="@item.Name" type="text" value="@itemModel.Value" readonly />
            }
            else if (item.Type == typeof(String))
            {
                if (item.ItemType.EqualIgnoreCase("image") || item.ItemType.StartsWithIgnoreCase("image-"))
                {
                    @await Html.PartialAsync(itemView ?? "_Form_Image", Model)
                }
                else if (item.ItemType.EqualIgnoreCase("file") || item.ItemType.StartsWithIgnoreCase("file-"))
                {
                    @await Html.PartialAsync(itemView ?? "_Form_File", Model)
                }
                else if (item.ItemType.EqualIgnoreCase("html"))
                {
                    @await Html.PartialAsync(itemView ?? "_Form_Html", Model)
                }
                else if (item.ItemType.EqualIgnoreCase("markdown"))
                {
                    @await Html.PartialAsync(itemView ?? "_Form_Markdown", Model)
                }
                else
                {
                    @await Html.PartialAsync(itemView ?? "_Form_String", itemModel)
                }
            }
            else if (entity is IEntityTree treeEntity)
            {
                var set = entityTreeSet ?? entity.GetType().GetValue("Setting") as IEntityTreeSetting;
                var isTreeParent = forceTree || (set != null && set.Parent.EqualIgnoreCase(item.Name)) || isParentField;
                if (!isTreeParent)
                {
                    @await Html.PartialAsync(itemView ?? "_Form_Editor", itemModel)
                }
                else
                {
                    var root = entity.GetType().GetValue("Root") as IEntityTree;
                    // 完整树，排除当前节点分支（避免把节点挂到自己的子孙下）
                    var list = root?.FindAllChildsExcept(treeEntity);
                    var htmlAtts = forceMulti ? (Object)new { multiple = "multiple", data_multiple = "1" } : null;
                    @await Html.PartialAsync(itemView ?? "_Form_TreeSelect", new ListBoxModel(item.Name, list, itemModel.Value, "<无>", false, htmlAtts))
                }
            }
            else
            {
                @await Html.PartialAsync(itemView ?? "_Form_Editor", itemModel)
            }
        }
    </div>
    @if (err > 0)
    {
        <div class="nv-field-error">
            <i class="nv-ico nv-ico-sm" data-nv-ico="alert"></i>
            <span>@Html.ValidationMessage(item.Name)</span>
        </div>
    }
    else if (!des.IsNullOrEmpty())
    {
        <div class="nv-field-hint" title="@des">@des</div>
    }
</div>
