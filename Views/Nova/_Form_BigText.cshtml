@model EntityField
@using NewLife;
@using NewLife.Cube
@using XCode;
@using XCode.Configuration;
@{
    var entity = Model.Entity;
    var field = Model.Field;

    var err = NovaForm.RealErrorCount(ViewData.ModelState, field.Name);

    // 说明文字：去「显示名」前缀 + 分隔符（不用已过时的 TrimStart 重载）
    var des = field.Description;
    if (!des.IsNullOrEmpty() && !field.DisplayName.IsNullOrEmpty() && des.StartsWith(field.DisplayName))
    {
        des = des.Substring(field.DisplayName.Length);
    }
    if (!des.IsNullOrEmpty())
    {
        des = des.TrimStart(',', '.', '，', '。', ' ', '\r', '\n');
    }
}
@* 分组视图若仍把长列送进来，有数据源或映射的字段改走 _Form_Item，避免再输出 textarea。 *@
@if (NovaForm.IgnoresStringLength(field))
{
    @await Html.PartialAsync("_Form_Item", Model)
}
else
{
<div class="nv-field @(err > 0 ? "has-error" : "") @(NovaForm.IsWideSingleLine(field) ? "nv-field-wide" : "")">
    <label class="nv-field-label" for="@field.Name" title="@field.DisplayName">@field.DisplayName</label>
    <div class="nv-field-ctl">
        @if (field.ReadOnly && NovaForm.IsUrlField(field.Name, field.ItemType))
        {
            <input class="nv-input nv-input-wide" id="@field.Name" type="text" value="@entity[field.Name]" readonly />
        }
        else if (field.ReadOnly)
        {
            var row = NovaForm.BigTextRows(field.Length);
            <textarea class="nv-textarea" id="@field.Name" rows="@row" readonly>@entity[field.Name]</textarea>
        }
        else
        {
            @await Html.PartialAsync("_Form_String", new ItemModel(field.Name, entity[field.Name], field.Type) { ItemType = field.ItemType, Length = field.Length })
        }
    </div>
    @if (err > 0)
    {
        var fail = NovaForm.FieldFailureText(ViewData.ModelState, field.Name, field.DisplayName);
        if (!fail.IsNullOrEmpty())
        {
            <div class="nv-field-error" title="@fail">
                <i class="nv-ico nv-ico-sm" data-nv-ico="alert"></i>
                <span>@fail</span>
            </div>
        }
    }
    else if (!des.IsNullOrEmpty())
    {
        <div class="nv-field-hint" title="@des">@des</div>
    }
</div>
}
