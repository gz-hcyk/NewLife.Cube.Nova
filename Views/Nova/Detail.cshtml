@using NewLife;
@using System.Reflection
@using XCode
@using XCode.Configuration
@using Microsoft.AspNetCore.Mvc.Rendering;
@{
    var theme = NewLife.Cube.CubeSetting.Current.Theme;
    if (String.IsNullOrEmpty(theme)) theme = "ACE";

    Layout = "~/Views/" + theme + "/_Layout.cshtml";

    var entity = Model as IEntity;
    var fields = ViewBag.Fields as FieldCollection;
    var set = ViewBag.PageSetting as PageSetting ?? PageSetting.Global;
}
@if (!set.NavView.IsNullOrEmpty())
{
    <div class="nv-mb-3">
        @await Html.PartialAsync(set.NavView)
    </div>
}
@* 卡片由 _Form_Body 渲染（详情只读；单分组一张卡、无页签，多分组同一张卡内 BS5 选项卡）。页头操作在卡片外。 *@
@{
    var formTitle = ViewBag.Title as String;
    var rv = entity.GetRouteKey();
    var canEdit = !set.IsReadOnly && this.Has(PermissionFlags.Update);
}
<div class="nv-detail-head">
    <div class="nv-form-title">@(formTitle.IsNullOrEmpty() ? "详情" : formTitle)</div>
    <div class="nv-page-actions">
        @if (canEdit)
        {
            <a class="nv-btn nv-btn-primary nv-btn-sm" href="@Url.Action("Edit", rv)">
                <i class="nv-ico nv-ico-sm" data-nv-ico="edit" aria-hidden="true"></i>编辑
            </a>
        }
        <button type="button" class="nv-btn nv-btn-sm" onclick="history.go(-1);">
            <i class="nv-ico nv-ico-sm" data-nv-ico="chevron_left" aria-hidden="true"></i>返回
        </button>
    </div>
</div>
@await Html.PartialAsync("_Form_Body", entity)
@await Html.PartialAsync("_Form_Footer", entity)
